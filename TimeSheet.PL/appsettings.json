{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets are intentionally empty here. This file is tracked in git.
  // Local development: dotnet user-secrets --project TimeSheet.PL
  // Production: environment variables using the __ separator,
  //   ConnectionStrings__Default (or DB_CONNECTION_STRING), jwtOptions__SecretKey.
  "ConnectionStrings": {
    "Default": ""
  },
  "jwtOptions": {
    "SecretKey": "",
    "Issuer": "TimeSheet",
    "Audience": "TimeSheetUsers",
    "DurationInMinutes": 60
  },
  "TimeSheetSettings": {
    "BusinessTimeZone": "Asia/Riyadh",
    "WeekStart": "Sunday",
    "MaxDailyHours": 12,
    "MaxBackdateDays": 30
  }
}
